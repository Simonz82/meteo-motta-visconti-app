<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/site_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#ffffff"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_title"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/login_subtitle"
            android:textColor="#9e9e9e"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/nomeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/account_nome_hint"
            android:inputType="textPersonName"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff"
            android:visibility="gone" />

        <EditText
            android:id="@+id/cognomeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/account_cognome_hint"
            android:inputType="textPersonName"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dataNascitaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/account_data_nascita_hint"
            android:textColor="#9e9e9e"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dataNascitaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/dayInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/date_day_hint"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:backgroundTint="#00d4ff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:textColor="#9e9e9e"
                android:textSize="18sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/monthInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/date_month_hint"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:backgroundTint="#00d4ff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:textColor="#9e9e9e"
                android:textSize="18sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/yearInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/date_year_hint"
                android:inputType="number"
                android:maxLength="4"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:backgroundTint="#00d4ff" />

        </LinearLayout>

        <EditText
            android:id="@+id/cittaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/account_citta_hint"
            android:inputType="textCapWords"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff"
            android:visibility="gone" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#ff5252"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00d4ff"
            android:text="@string/login_button" />

        <Button
            android:id="@+id/btnBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1c1f24"
            android:textColor="#00d4ff"
            android:text="@string/biometric_login_button"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/toggleModeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="@string/switch_to_register"
            android:textColor="#00d4ff"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/forgotPasswordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/forgot_password"
            android:textColor="#9e9e9e"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
