<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/site_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#ffffff"
        android:contentDescription="@string/back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/account_title"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/emailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textColor="#00d4ff"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/nomeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/account_nome_hint"
            android:inputType="textPersonName"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff" />

        <EditText
            android:id="@+id/cognomeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/account_cognome_hint"
            android:inputType="textPersonName"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/account_data_nascita_hint"
            android:textColor="#9e9e9e"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/dayInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/date_day_hint"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:backgroundTint="#00d4ff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:textColor="#9e9e9e"
                android:textSize="18sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/monthInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/date_month_hint"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:backgroundTint="#00d4ff" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:textColor="#9e9e9e"
                android:textSize="18sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/yearInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/date_year_hint"
                android:inputType="number"
                android:maxLength="4"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:backgroundTint="#00d4ff" />

        </LinearLayout>

        <EditText
            android:id="@+id/cittaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/account_citta_hint"
            android:inputType="textCapWords"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff" />

        <EditText
            android:id="@+id/noteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/account_note_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:gravity="top|start"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:backgroundTint="#00d4ff" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#00d4ff"
            android:text="@string/save_button" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#3a1c1c"
            android:textColor="#ff8080"
            android:text="@string/account_logout_button" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp" />

</LinearLayout>
</ScrollView>
