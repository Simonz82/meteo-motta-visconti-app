<?xml version="1.0" encoding="utf-8"?>
<!-- Restyle 2026-09-25: card in stile "glass" (tema Scuro/default), coerente con la
     dashboard web (vedi index.html .dashboard-panel/.section-title). CheckBox
     sostituiti da SwitchMaterial. Aggiunta riga UV alto (checkUv), prima assente
     su questo schermo pur esistendo lato backend/sito. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notifScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/site_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_button"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#ffffff"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/notifications_title"
            android:textColor="#ffffff"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mostrato solo se NON loggato -->
    <LinearLayout
        android:id="@+id/loggedOutGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications_login_required"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cornerRadius="15dp"
            android:backgroundTint="@color/accent"
            android:textColor="#00222a"
            android:textStyle="bold"
            android:text="@string/login_button" />
    </LinearLayout>

    <!-- Mostrato solo se loggato -->
    <LinearLayout
        android:id="@+id/loggedInGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Card: Allerte meteo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/notif_section_allerte"
                    android:textColor="#ffffff"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="6dp" android:background="@color/border_color" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="🚨" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_allerta_meteo" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkAllerta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="⚡" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_fulmine_vicino" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkFulmine" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="🌧️" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_inizia_a_piovere" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkPioggia" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="☀️" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_uv_alto" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkUv" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="🏆" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_nuovo_record" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkRecord" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="🔄" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_app_update" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkAppUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Notizie locali -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/notif_news_section_title"
                    android:textColor="#ffffff"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="6dp" android:background="@color/border_color" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="📍" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_news_motta" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkNewsMotta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="📍" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_news_casorate" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkNewsCasorate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="📍" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_news_bereguardo" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkNewsBereguardo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/row_divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="9dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp" android:text="📍" android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/notif_news_besate" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/checkNewsBesate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        app:thumbTint="@drawable/switch_thumb_tint" app:trackTint="@drawable/switch_track_tint" android:text="" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Fascia oraria -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notif_time_window_title"
                    android:textColor="#ffffff"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/notif_time_window_subtitle"
                    android:textColor="@color/text_faint"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_time_from"
                        android:textColor="@color/text_muted"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrarioDa"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/border_color_2"
                        android:backgroundTint="@color/bg_card_2"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:text="08:00" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_time_to"
                        android:textColor="@color/text_muted"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrarioA"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/border_color_2"
                        android:backgroundTint="@color/bg_card_2"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:text="23:00" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cornerRadius="15dp"
            android:backgroundTint="@color/accent"
            android:textColor="#00222a"
            android:textStyle="bold"
            android:text="@string/save_button" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp" />

</LinearLayout>
</ScrollView>
